diff --git a/npdm.c b/npdm.c
index 8457ec5..b83d303 100644
--- a/npdm.c
+++ b/npdm.c
@@ -484,6 +484,9 @@ static void sac_parse(char *sac, uint32_t sac_size, sac_entry_t *r_host, sac_ent
     while (ofs < sac_size) {
         ctrl = sac[ofs++];
         service_len = (ctrl & 0xF) + 1;
+        if (service_len > sac_size - ofs) {
+            break;
+        }
         cur_entry = calloc(1, sizeof(sac_entry_t));
         if (ctrl & 0x80) {
             cur_entry->valid = r_host != NULL ? sac_matches(r_host, cur_entry->service) : 1;
@@ -591,6 +594,35 @@ static void fac_print(fac_t *fac, fah_t *fah) {
     printf("\n");
 }
 
+static int npdm_region_ok(uint64_t ofs, uint64_t len, uint64_t limit) {
+    return ofs <= limit && len <= limit - ofs;
+}
+
+/* Checks that every offset/size the NPDM code follows stays inside the file. */
+int npdm_is_valid(const npdm_t *npdm, uint64_t size) {
+    if (npdm == NULL || size < sizeof(npdm_t) || npdm->magic != MAGIC_META) {
+        return 0;
+    }
+    if (!npdm_region_ok(npdm->acid_offset, npdm->acid_size, size) || npdm->acid_size < sizeof(npdm_acid_t) ||
+        !npdm_region_ok(npdm->aci0_offset, npdm->aci0_size, size) || npdm->aci0_size < sizeof(npdm_aci0_t)) {
+        return 0;
+    }
+    const npdm_acid_t *acid = (const npdm_acid_t *)((const char *)npdm + npdm->acid_offset);
+    const npdm_aci0_t *aci0 = (const npdm_aci0_t *)((const char *)npdm + npdm->aci0_offset);
+    if (!npdm_region_ok(acid->kac_offset, acid->kac_size, npdm->acid_size) ||
+        !npdm_region_ok(acid->sac_offset, acid->sac_size, npdm->acid_size) ||
+        !npdm_region_ok(acid->fac_offset, sizeof(fac_t), npdm->acid_size) ||
+        !npdm_region_ok(acid->modulus - (const uint8_t *)acid, (uint64_t)acid->size, npdm->acid_size)) {
+        return 0;
+    }
+    if (!npdm_region_ok(aci0->kac_offset, aci0->kac_size, npdm->aci0_size) ||
+        !npdm_region_ok(aci0->sac_offset, aci0->sac_size, npdm->aci0_size) ||
+        !npdm_region_ok(aci0->fah_offset, sizeof(fah_t), npdm->aci0_size)) {
+        return 0;
+    }
+    return 1;
+}
+
 void npdm_process(npdm_t *npdm, hactool_ctx_t *tool_ctx) {
     if (tool_ctx->action & ACTION_INFO) {
         npdm_print(npdm, tool_ctx);
@@ -609,7 +641,7 @@ void npdm_print(npdm_t *npdm, hactool_ctx_t *tool_ctx) {
     printf("    Default CPU ID:                 %"PRIx8"\n", npdm->default_cpuid);
     printf("    Version:                        %"PRIu32".%"PRIu32".%"PRIu32"-%"PRIu32" (%"PRIu32")\n", (npdm->version >> 26) & 0x3F, (npdm->version >> 20) & 0x3F, (npdm->version >> 16) & 0xF, (npdm->version >> 0) & 0xFFFF, npdm->version);
     printf("    Main Thread Stack Size:         0x%"PRIx32"\n", npdm->main_stack_size);
-    printf("    Title Name:                     %s\n", npdm->title_name);
+    printf("    Title Name:                     %.*s\n", (int)sizeof(npdm->title_name), npdm->title_name);
     npdm_acid_t *acid = npdm_get_acid(npdm);
     npdm_aci0_t *aci0 = npdm_get_aci0(npdm);
     printf("    ACID:\n");
